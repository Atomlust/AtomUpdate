<?xml version="1.0" encoding="utf-8"?>
<!-- NuGet 源配置：
     - nuget.org：稳定包
     - dotnet11：.NET 11 RTM/RC 预览包（Microsoft.AspNetCore.* / EntityFrameworkCore 11.x）
     AtomUpdate 自 .NET 11 起与 Atom.BlazorUI（net11.0-only）对齐，微软系包走 dotnet11 源。
     中央包管理（ManagePackageVersionsCentrally）下多源必须配包源映射（NU1507）。 -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="dotnet11" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet11/nuget/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <!-- dnceng 构建的 .NET 11 系列（AspNetCore/JSInterop/EFCore/Extensions/System.*）：
         两个源都考虑，由 NuGet 取满足版本约束的最高版本（rtm 只在 dotnet11 有） -->
    <packageSource key="dotnet11">
      <package pattern="Microsoft.*" />
      <package pattern="System.*" />
    </packageSource>
    <!-- 其余一律 nuget.org（含 Microsoft.NET.Test.Sdk / Npgsql* / FluentValidation 等） -->
    <packageSource key="nuget.org">
      <package pattern="*" />
      <!-- 下列微软系包只发稳定线、dotnet11 源上没有（预释版也不满足稳定约束），
           且比 Microsoft.* / System.* 更精确，故按"最精确模式胜出"走 nuget.org。
           清单由 Docker 冷缓存还原实测得出（本地热缓存不会暴露此问题），
           新增依赖若再撞 NU1101/NU1103，按同样方式补精确模式即可：
           - Microsoft.CodeAnalysis.*  ：Microsoft.EntityFrameworkCore.Design 的依赖（Roslyn）
           - Microsoft.OpenApi.*       ：Microsoft.AspNetCore.OpenApi 的依赖
           - Microsoft.IdentityModel.* ：Microsoft.AspNetCore.Authentication.JwtBearer 的依赖
           - Microsoft.Build.*         ：EF Design → Roslyn 的传递依赖
           - Microsoft.VisualStudio.*  ：EF Design 的传递依赖（SolutionPersistence）
           - System.CodeDom / System.Composition ：Roslyn 的传递依赖
           - Microsoft.IO.*           ：AvaloniaUI.DiagnosticsSupport（Packager）的依赖，
                                        稳定线包，dotnet11 源没有；Packager 不在 Docker
                                        构建闭包内，冷构建实测未暴露，本地缓存被清后暴露
           - Microsoft.NET.Test.Sdk / Microsoft.CodeCoverage / Microsoft.TestPlatform*：
                                        xUnit 测试栈，稳定线包，dotnet11 源没有；测试项目
                                        不在 Docker 构建闭包内，GitHub Actions 冷还原实测
                                        暴露（NU1101） -->
      <package pattern="Microsoft.CodeAnalysis*" />
      <package pattern="Microsoft.OpenApi*" />
      <package pattern="Microsoft.IdentityModel*" />
      <package pattern="System.IdentityModel*" />
      <package pattern="Microsoft.Build*" />
      <package pattern="Microsoft.VisualStudio*" />
      <package pattern="Microsoft.Bcl*" />
      <package pattern="Microsoft.IO*" />
      <package pattern="Microsoft.NET.Test.Sdk" />
      <package pattern="Microsoft.CodeCoverage" />
      <package pattern="Microsoft.TestPlatform*" />
      <package pattern="System.CodeDom" />
      <package pattern="System.Composition*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
