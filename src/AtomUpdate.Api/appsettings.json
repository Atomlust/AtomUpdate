{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "sqlite"
  },
  "Storage": {
    "MaxUploadBytes": 536870912
  },
  "IdGen": {
    "GeneratorId": 0
  },
  "Auth": {
    "Jwt": {
      "Issuer": "AtomUpdate",
      "Audience": "AtomUpdate"
    },
    "AllowAnonymousCheck": true
  },
  "Cache": {
    "ReleaseTtlSeconds": 30
  }
}
