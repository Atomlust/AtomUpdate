{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information",
      "Microsoft.AspNetCore.Authentication": "Information",
      "Microsoft.AspNetCore.Authorization": "Information"
    }
  },
  "Database": {
    // 本地开发默认 SQLite 零配置：库文件落 Api 项目根 atomupdate.db，启动自动迁移
    // （基础 appsettings.json 即 sqlite，此处显式声明以防歧义）。
    // 如需切回 PostgreSQL：把 Provider 改为 "npgsql"（下方连接串已备好）。
    "Provider": "sqlite"
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=atomupdate;Username=postgres;Password=123456789"
  },
  "Auth": {
    "Jwt": {
      "SigningKey": "dev-only-insecure-signing-key-change-me-0123456789"
    },
    "Bootstrap": {
      "Email": "admin@atomlust.com",
      "Password": "admin@12345678",
      "TenantSlug": "default"
    }
  }
}
