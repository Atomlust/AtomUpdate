{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "sqlite"
  },
  "IdGen": {
    "GeneratorId": 0
  },
  "Auth": {
    "Jwt": {
      "Issuer": "AtomUpdate",
      "Audience": "AtomUpdate"
    },
    "AllowAnonymousCheck": true
  },
  "Cache": {
    "ReleaseTtlSeconds": 30,
    "ReadTtlSeconds": 30
  },
  "Storage": {
    "Root": "uploads"
  },
  "AdminApi": {
    "BaseUrl": "http://localhost:8080/"
  }
}
