{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      // 临时密钥环（Program.cs）下容器重启后旧 antiforgery Cookie 必然解不开，
      // 异常已被 GetCookieTokenDoesNotThrow 吞掉、不影响结果，日志纯噪音。
      "Microsoft.AspNetCore.Antiforgery": "None",
      // HTTP-only 容器里 UseHttpsRedirection 找不到 https 端口，每个请求一条 warn，无行为影响。
      "Microsoft.AspNetCore.HttpsPolicy": "Error"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "sqlite"
  },
  "IdGen": {
    "GeneratorId": 0
  },
  "Auth": {
    "Jwt": {
      "Issuer": "AtomUpdate",
      "Audience": "AtomUpdate"
    },
    "AllowAnonymousCheck": true
  },
  "Cache": {
    "ReleaseTtlSeconds": 30,
    "ReadTtlSeconds": 30
  },
  "Storage": {
    "Root": "uploads"
  },
  "AdminApi": {
    "BaseUrl": "http://localhost:8080/"
  }
}
