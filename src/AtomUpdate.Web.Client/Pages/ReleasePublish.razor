@page "/releases/{ReleaseId:long}/publish"
@inject ApiClient Api
@inject ToastService Toast
@inject NavigationManager Navigation

<PageTitle>发布版本 - AtomUpdate 管理后台</PageTitle>

<PageContainer Title="@($"发布 {(_release?.Version ?? ReleaseId.ToString())}")"
               Description="选择一个或多个通道发布；发布后客户端即可在该通道检查到此版本">
    <Extra>
        <div class="au-form-actions">
            <Button Variant="ButtonVariant.Default" Disabled="_saving || _release is null" OnClick="SaveAsync">@(_saving ? "发布中…" : "确认发布")</Button>
            <Button Variant="ButtonVariant.Outline" OnClick="Cancel">取消</Button>
        </div>
    </Extra>

    <ChildContent>
        @if (_error is { } error)
        {
            <div class="au-state-block">
                <span class="au-state-title">@error</span>
                <Button Variant="ButtonVariant.Default" OnClick="@(() => Navigation.NavigateTo("/releases"))">返回版本列表</Button>
            </div>
        }
        else if (_release is { } release)
        {
            <ul class="au-detail-list">
                <li><b>版本号：</b>@release.Version</li>
                <li><b>平台（来自应用）：</b>@PlatformText</li>
                <li><b>包架构：</b>@EnumLabels.Archs(release.Assets)</li>
                <li><b>状态：</b>@release.Status</li>
                <li><b>当前通道：</b>@(release.Channels.Count == 0 ? "未发布" : string.Join("、", release.Channels.Select(c => $"{c.Channel}（{c.Status}）")))</li>
            </ul>

            <Separator />

            <span class="au-field-label">发布到通道</span>
            <div class="au-check-grid">
                @foreach (var (value, label) in AllChannels)
                {
                    <div class="au-check">
                        <Checkbox Id="@($"pub-{value}")"
                                      Checked="@_channels.Contains(value)"
                                      CheckedChanged="on => ToggleChannel(value, on)" />
                        <label for="@($"pub-{value}")">@label</label>
                    </div>
                }
            </div>
        }
    </ChildContent>
</PageContainer>

@code {
    private static readonly (UpdateChannel Value, string Label)[] AllChannels =
    [
        (UpdateChannel.Dev, "开发版"),
        (UpdateChannel.Preview, "预览版"),
        (UpdateChannel.Beta, "公测版"),
        (UpdateChannel.Rc, "候选版"),
        (UpdateChannel.Stable, "正式稳定版")
    ];

    [Parameter]
    public long ReleaseId { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "projectId")]
    public long? QueryProjectId { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "appId")]
    public long? QueryAppId { get; set; }

    private ReleaseDto? _release;
    private string? _error;
    private bool _saving;
    private UpdatePlatform? _platform;
    private UpdateChannel[] _channels = [];

    private ReleaseScope? Scope => ReleaseScope.TryCreate(QueryProjectId, QueryAppId);

    private string PlatformText => _platform is { } p ? EnumLabels.Platform(p) : "—";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        if (Scope is not { } scope)
        {
            _error = "缺少 projectId / appId 参数，请从版本列表进入";
            StateHasChanged();
            return;
        }

        var (release, error) = await scope.FindAsync(Api, ReleaseId);
        var message = error;
        if (release is not null && release.Status is not (ReleaseStatus.Draft or ReleaseStatus.Prerelease))
        {
            message = $"版本 {release.Version} 当前为 {release.Status}，无需在此页发布";
            release = null;
        }

        _release = release;
        _error = message;
        if (release is not null)
        {
            _platform = await scope.PlatformAsync(Api);
        }

        StateHasChanged();
    }

    private void ToggleChannel(UpdateChannel channel, bool isChecked)
    {
        _channels = isChecked
            ? _channels.Append(channel).Distinct().ToArray()
            : _channels.Where(c => c != channel).ToArray();
    }

    private async Task SaveAsync()
    {
        if (Scope is not { } scope || _release is null)
        {
            return;
        }

        if (_channels.Length == 0)
        {
            Toast.Error("请至少选择一个通道");
            return;
        }

        _saving = true;
        try
        {
            var result = await Api.SendAsync<ReleaseDto>(HttpMethod.Post, scope.ApiUrl(ReleaseId, "/publish"),
                new ReleasePublishRequest { Channels = _channels });
            if (!result.IsSuccess)
            {
                Toast.Error(result.ErrorMessage ?? "发布失败", "发布失败");
                return;
            }

            Toast.Success($"已发布 {_release.Version}");
            Navigation.NavigateTo(scope.DetailUrl(ReleaseId));
        }
        finally
        {
            _saving = false;
        }
    }

    private void Cancel() =>
        Navigation.NavigateTo(Scope?.DetailUrl(ReleaseId) ?? "/releases");
}
