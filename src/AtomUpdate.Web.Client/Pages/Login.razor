@page "/login"
@layout BareLayout
@implements IAsyncDisposable
@inject ApiClient Api
@inject NavigationManager Navigation
@inject ToastService Toast
@inject IJSRuntime JS

<PageTitle>登录 - AtomUpdate 管理后台</PageTitle>

@* 登录页形态：顶部品牌 + 居中白色卡片 + 底部版权；页面级样式见 Web/wwwroot/app.css（au-login*）。 *@
<div class="au-login">
    <div class="au-login-header">
        <span class="au-login-mark">A</span>
        <span class="au-login-title">AtomUpdate 管理后台</span>
    </div>
    <p class="au-login-desc">更新发布 · 应用策略 · 设备与审计</p>

    <div class="au-login-main">
        <div class="au-login-card">
            <div class="au-login-tabs">账户密码登录</div>
            @if (_setupRequired)
            {
                <p class="au-state-desc">
                    首次部署：还没有管理员账号，
                    <a href="setup">前往初始化设置</a>
                </p>
            }
            <EditForm Model="_model" OnSubmit="HandleLoginAsync">
                <Field>
                    <FieldLabel For="login-email">用户名或邮箱</FieldLabel>
                    <FieldContent>
                        @* Immediate：默认 OnChange 只在失焦/回车回写，浏览器自动填充或线路抖动时
                           事件丢失会让模型停在空串（表现为"填了却说 Email 不能为空"）。 *@
                        <Input Id="login-email"
                               Type="InputType.Text"
                               @bind-Value="_model.Email"
                               UpdateTiming="UpdateTiming.Immediate"
                               AdditionalAttributes="@(new Dictionary<string, object> { ["autocomplete"] = "username" })"
                               Placeholder="用户名或邮箱"
                               Disabled="_loading" />
                    </FieldContent>
                </Field>
                <Field>
                    <FieldLabel For="login-password">密码</FieldLabel>
                    <FieldContent>
                        <Input Id="login-password"
                               Type="InputType.Password"
                               @bind-Value="_model.Password"
                               UpdateTiming="UpdateTiming.Immediate"
                               AdditionalAttributes="@(new Dictionary<string, object> { ["autocomplete"] = "current-password" })"
                               Placeholder="密码"
                               Disabled="_loading" />
                    </FieldContent>
                </Field>
                <Button Type="ButtonType.Submit"
                        Variant="ButtonVariant.Default"
                        Class="au-btn-block"
                        Disabled="_loading">
                    @(_loading ? "登录中…" : "登录")
                </Button>
                @* 版本信息放在卡片内：页面较长/窗口较矮时页脚会被挤出视野，登录排障时先看这里 *@
                <div class="au-login-meta">@AppVersion.Display · <RenderModeBadge /></div>
            </EditForm>
        </div>
    </div>

    <div class="au-login-footer">AtomUpdate <span class="au-version">@AppVersion.Display</span> · <RenderModeBadge /> ©2026</div>
</div>

<BootSplashDismiss />

@code {
    private LoginModel _model = new();
    private bool _loading;
    private bool _setupRequired;
    private IJSObjectReference? _inputsJs;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _inputsJs = await JS.InvokeAsync<IJSObjectReference>("import", "./js/login-inputs.js");
        }
        catch (JSException)
        {
            // 模块加载失败时不阻断登录，退回仅用模型值
        }

        // 空库（未初始化）时在登录页提示进入设置向导；查询失败静默跳过（不影响正常登录）
        var status = await Api.GetSetupStatusAsync();
        if (status.IsSuccess && status.Data is { Required: true })
        {
            _setupRequired = true;
            StateHasChanged();
        }
    }

    private async Task HandleLoginAsync(EditContext context)
    {
        _loading = true;
        StateHasChanged();
        try
        {
            var (email, password) = await ResolveCredentialsAsync();
            if (string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(password))
            {
                // 模型与 DOM 都为空时给出中文提示，避免直出 Api 的 FluentValidation 英文消息
                Toast.Error("请填写用户名或邮箱与密码", "登录失败");
                return;
            }

            _model.Email = email;
            _model.Password = password;

            var result = await Api.LoginAsync(new LoginRequest { Email = email, Password = password });
            if (result.IsSuccess)
            {
                Navigation.NavigateTo("/", replace: true);
                return;
            }

            Toast.Error(result.ErrorMessage ?? "登录失败，请稍后重试", "登录失败");
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    /// <summary>模型没拿到值（浏览器自动填充/密码管理器不触发 input/change）时，从 DOM 兜底读取。</summary>
    private async Task<(string Email, string Password)> ResolveCredentialsAsync()
    {
        var email = _model.Email;
        var password = _model.Password;
        if (!string.IsNullOrWhiteSpace(email) && !string.IsNullOrWhiteSpace(password))
        {
            return (email, password);
        }

        if (_inputsJs is not null)
        {
            try
            {
                var dom = await _inputsJs.InvokeAsync<string?[]>("readLoginValues", "login-email", "login-password");
                if (dom is { Length: 2 })
                {
                    email = string.IsNullOrWhiteSpace(email) ? dom[0] ?? "" : email;
                    password = string.IsNullOrWhiteSpace(password) ? dom[1] ?? "" : password;
                }
            }
            catch (JSException)
            {
                // DOM 读取失败时保持模型值
            }
        }

        return (email, password);
    }

    public async ValueTask DisposeAsync()
    {
        if (_inputsJs is null)
        {
            return;
        }

        try
        {
            await _inputsJs.DisposeAsync();
        }
        catch (JSException)
        {
            // 线路已断开（页面已卸载）时无需处理
        }
    }

    private sealed class LoginModel
    {
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
    }
}
